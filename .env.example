NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for server-side API routes (chat, etc.) - bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (email transactionnel) — obtenir sur https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=commandes@tech-geo.com

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=ta_cle_vapid_publique
VAPID_PRIVATE_KEY=ta_cle_vapid_privee
NEXT_PUBLIC_SITE_URL=https://ton-site.vercel.app
